# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Sensitive user uploads and generated reports
uploads/*
!uploads/.gitkeep
reports/*
!reports/.gitkeep

# Local database files
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment and secrets
.env
.env.*
secrets.toml
*.local

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
